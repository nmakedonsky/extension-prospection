{
  "manifest_version": 3,
  "name": "Prospection",
  "version": "0.5.73",
  "description": "LinkedIn Jobs (Client+SS2I) + profils /in/ → Supabase, badges, HubSpot / SendPilot en option.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.linkedin.com/*",
    "https://openrouter.ai/*",
    "https://*.supabase.co/*",
    "https://api.hubapi.com/*",
    "https://api-eu1.hubapi.com/*",
    "https://api.sendpilot.ai/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Prospection"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["content/profiles/page-hook.js"],
      "matches": ["https://www.linkedin.com/*", "https://*.linkedin.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*",
        "https://*.linkedin.com/*"
      ],
      "exclude_matches": [
        "https://www.linkedin.com/in/*",
        "https://linkedin.com/in/*",
        "https://*.linkedin.com/in/*"
      ],
      "js": [
        "content/jobs/constants.js",
        "content/jobs/page-config.js",
        "content/jobs/dom-deep.js",
        "content/jobs/geometry-path.js",
        "content/jobs/company-from-card.js",
        "content/jobs/collect-cards.js",
        "content/jobs/perf-metrics.js",
        "content/jobs/scan.js",
        "content/jobs/badges-classify.js",
        "content/jobs/heartbeat.js",
        "content/jobs/jobs-run.js",
        "content/financial/constants.js",
        "content/financial/messaging.js",
        "content/financial/path-and-eligibility.js",
        "content/financial/company-dock.js",
        "content/jobs/jobdesk-scrape.js",
        "content/jobs/jobdesk-autoopen.js",
        "content/jobs/list-workflow.js",
        "content/company-match-context.js",
        "content/financial/dock-shell.js",
        "content/financial/metrics-render.js",
        "content/financial/panel-populate.js",
        "content/financial/selection-handlers.js",
        "content/financial/financial-run.js",
        "content/jobs/prefetch-client-financial.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.linkedin.com/in/*",
        "https://linkedin.com/in/*",
        "https://*.linkedin.com/in/*"
      ],
      "js": ["content/profiles/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.linkedin.com/in/*",
        "https://linkedin.com/in/*",
        "https://*.linkedin.com/in/*"
      ],
      "js": [
        "content/profiles/inject-hook.js",
        "content/profiles/profile-parse.js",
        "content/profiles/profile-run.js"
      ],
      "run_at": "document_start"
    }
  ]
}
